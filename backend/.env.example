# Copy this file to .env and fill in your own values. Never commit .env.

# Random long string used to sign login sessions (JWT). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on locally.
PORT=4000

# Where the SQLite database file lives. Fine to leave as the default.
# DATABASE_FILE=./data/afrolink.db

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Leave blank while developing locally (opening the HTML files directly, or via a
# dev server on an unpredictable port) — set this once you deploy to a real domain,
# e.g. CORS_ORIGIN=https://afrolink.com,https://www.afrolink.com
CORS_ORIGIN=

# Stripe (https://dashboard.stripe.com/apikeys — use your TEST keys first).
# Leave blank to run the API without payments (order-related endpoints will
# respond with a clear "Stripe not configured" error instead of crashing).
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the webhook's settings page once deployed.
STRIPE_WEBHOOK_SECRET=

# Where Stripe redirects the buyer after a successful/canceled payment.
# Point these at your deployed frontend (e.g. https://afrolink.example.com/messagerie.html?paid=1).
STRIPE_SUCCESS_URL=http://localhost:5500/messagerie.html?paid=1
STRIPE_CANCEL_URL=http://localhost:5500/messagerie.html?canceled=1
